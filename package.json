{
  "name": "obs-clock-overlay-builder",
  "version": "0.6.0",
  "description": "Static builder for reproducible transparent OBS clock overlay URLs.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h8nc4y/obs-clock-overlay-builder.git"
  },
  "homepage": "https://obs-clock-overlay-builder.h8nc4y.workers.dev",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "dev": "node scripts/serve.mjs",
    "lint": "node scripts/check-js.mjs",
    "typecheck": "node scripts/module-smoke.mjs",
    "format:check": "node scripts/format-check.mjs",
    "http:smoke": "node scripts/http-smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:http-smoke": "node scripts/release-http-smoke.mjs",
    "release:remote-smoke": "node scripts/release-remote-smoke.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.92.0"
  }
}
