{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obs-clock-overlay-builder",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "obs-clock-overlay-builder-staging"
    },
    "production": {
      "name": "obs-clock-overlay-builder"
    }
  }
}
